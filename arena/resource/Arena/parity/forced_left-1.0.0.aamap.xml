<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE Resource SYSTEM "AATeam/map-0.2.8.0_rc4.dtd">
<Resource type="aamap" name="forced_left" version="1.0.0" author="Arena" category="parity">
  <Map version="2">
    <!-- GPLv2+. Test-only parity fixture: both straight lanes are safe for
         minutes; one accepted turn reaches a static rail with wide timing
         margin. The two lanes are symmetric, so spawn assignment is immaterial. -->
    <Settings>
      <Setting name="MAP_FILE_OVERRIDE" value="0" />
      <Setting name="SPAWN_POINT_GROUP_SIZE" value="1" />
    </Settings>
    <World>
      <Field>
        <Spawn x="1000" y="1000" xdir="1" ydir="0" />
        <Spawn x="1000" y="3000" xdir="1" ydir="0" />

        <Wall>
          <Point x="0" y="0" />
          <Point x="0" y="10000" />
          <Point x="10000" y="10000" />
          <Point x="10000" y="0" />
          <Point x="0" y="0" />
        </Wall>

        <Wall height="4"><Point x="0" y="960" /><Point x="9000" y="960" /></Wall>
        <Wall height="4"><Point x="0" y="1040" /><Point x="9000" y="1040" /></Wall>
        <Wall height="4"><Point x="0" y="2960" /><Point x="9000" y="2960" /></Wall>
        <Wall height="4"><Point x="0" y="3040" /><Point x="9000" y="3040" /></Wall>

        <!-- Low mirrored witnesses make a live frame visibly nonblank. They
             stay behind the collision rails and cannot alter the result. -->
        <Wall height="4">
          <Point x="0" y="800" /><Point x="500" y="920" />
          <Point x="1000" y="800" /><Point x="1500" y="920" />
          <Point x="2000" y="800" /><Point x="2500" y="920" />
          <Point x="3000" y="800" /><Point x="3500" y="920" />
          <Point x="4000" y="800" /><Point x="4500" y="920" />
          <Point x="5000" y="800" /><Point x="5500" y="920" />
          <Point x="6000" y="800" /><Point x="6500" y="920" />
          <Point x="7000" y="800" /><Point x="7500" y="920" />
          <Point x="8000" y="800" /><Point x="8500" y="920" />
          <Point x="9000" y="800" />
        </Wall>
        <Wall height="4">
          <Point x="0" y="3200" /><Point x="500" y="3080" />
          <Point x="1000" y="3200" /><Point x="1500" y="3080" />
          <Point x="2000" y="3200" /><Point x="2500" y="3080" />
          <Point x="3000" y="3200" /><Point x="3500" y="3080" />
          <Point x="4000" y="3200" /><Point x="4500" y="3080" />
          <Point x="5000" y="3200" /><Point x="5500" y="3080" />
          <Point x="6000" y="3200" /><Point x="6500" y="3080" />
          <Point x="7000" y="3200" /><Point x="7500" y="3080" />
          <Point x="8000" y="3200" /><Point x="8500" y="3080" />
          <Point x="9000" y="3200" />
        </Wall>
      </Field>
    </World>
  </Map>
