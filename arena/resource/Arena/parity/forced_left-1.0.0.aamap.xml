<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE Resource SYSTEM "AATeam/map-0.2.8.0_rc4.dtd">
<Resource type="aamap" name="forced_left" version="1.0.0" author="Arena" category="parity">
  <Map version="2">
    <!-- GPLv2+. Test-only parity fixture: both straight lanes are safe for
         minutes; one accepted turn reaches a static rail with wide timing
         margin. Mirrored render witnesses stay sealed behind the rails. -->
    <Settings>
      <Setting name="MAP_FILE_OVERRIDE" value="0" />
      <Setting name="SPAWN_POINT_GROUP_SIZE" value="1" />
    </Settings>
    <World>
      <Field>
        <Spawn x="1000" y="1000" xdir="1" ydir="0" />
        <Spawn x="1000" y="3000" xdir="1" ydir="0" />

        <Wall>
          <Point x="0" y="0" />
          <Point x="0" y="10000" />
          <Point x="10000" y="10000" />
          <Point x="10000" y="0" />
          <Point x="0" y="0" />
        </Wall>

        <Wall height="4"><Point x="0" y="960" /><Point x="9000" y="960" /></Wall>
        <Wall height="4"><Point x="0" y="1040" /><Point x="9000" y="1040" /></Wall>
        <Wall height="4"><Point x="0" y="2960" /><Point x="9000" y="2960" /></Wall>
        <Wall height="4"><Point x="0" y="3040" /><Point x="9000" y="3040" /></Wall>

        <!-- The legacy wall renderer is visually sparse in this camera. These
             bright, static witnesses repeat along both paths so capture timing
             cannot move past them. Every radius remains behind a continuous
             collision rail; reaching one would already require dying. -->
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="1000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="2000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="3000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="4000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="5000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="6000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="7000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="8000" y="800" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="1000" y="3200" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="2000" y="3200" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="3000" y="3200" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="4000" y="3200" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="5000" y="3200" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="6000" y="3200" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="7000" y="3200" /></ShapeCircle></Zone>
        <Zone effect="win"><ShapeCircle radius="100" growth="0"><Point x="8000" y="3200" /></ShapeCircle></Zone>
      </Field>
    </World>
  </Map>
</Resource>
